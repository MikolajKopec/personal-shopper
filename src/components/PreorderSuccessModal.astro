<div id="modal-preorder-success" class="modal-overlay fixed inset-0 z-[100] hidden items-center justify-center bg-espresso/60 backdrop-blur-sm px-6">
  <div class="modal-card bg-white rounded-2xl p-8 md:p-10 max-w-[440px] w-full text-center shadow-brand-lg">
    <div class="w-12 h-12 rounded-full bg-success/10 flex items-center justify-center mx-auto mb-6">
      <svg class="w-6 h-6 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <h3 class="font-display text-2xl text-ink mb-3">Miejsce zarezerwowane!</h3>

    <p class="font-body text-warm-gray leading-relaxed mb-8">
      Dziękujemy za zaufanie. Odezwiemy się wkrótce z kolejnymi krokami.
    </p>

    <button
      id="modal-preorder-success-close"
      class="w-full py-3.5 rounded-full border border-stone text-espresso font-body font-medium text-sm
             hover:bg-sand transition-colors duration-300"
    >
      Zamknij
    </button>
  </div>
</div>
