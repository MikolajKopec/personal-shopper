---
---

<section id="formularz" class="px-6 py-20 md:py-28">
  <div class="max-w-[480px] mx-auto">
    <h2 class="reveal font-display text-[clamp(1.5rem,3.5vw,2.2rem)] text-ink text-center mb-10">
      Sprawdź, czy to coś dla Ciebie
    </h2>

    <form id="signup-form" class="reveal reveal-delay-1 bg-white rounded-2xl p-8 shadow-brand-md space-y-5">
      <div>
        <label for="name" class="block text-sm font-body font-medium text-espresso mb-1.5">Imię</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-3 rounded-xl border border-stone bg-ivory text-espresso font-body
                 focus:outline-none focus:ring-2 focus:ring-brass/40 focus:border-brass transition-colors"
          placeholder="Twoje imię"
        />
        <p class="error-msg text-error text-xs mt-1 hidden" data-field="name"></p>
      </div>

      <div>
        <label for="email" class="block text-sm font-body font-medium text-espresso mb-1.5">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-3 rounded-xl border border-stone bg-ivory text-espresso font-body
                 focus:outline-none focus:ring-2 focus:ring-brass/40 focus:border-brass transition-colors"
          placeholder="twoj@email.pl"
        />
        <p class="error-msg text-error text-xs mt-1 hidden" data-field="email"></p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="size" class="block text-sm font-body font-medium text-espresso mb-1.5">Twój rozmiar</label>
          <select
            id="size"
            name="size"
            required
            class="w-full px-4 py-3 rounded-xl border border-stone bg-ivory text-espresso font-body
                   focus:outline-none focus:ring-2 focus:ring-brass/40 focus:border-brass transition-colors
                   appearance-none bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%23766B5E%22%20d%3D%22M2%204l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px] bg-[right_16px_center] bg-no-repeat"
          >
            <option value="" disabled selected>Wybierz</option>
            <option value="xs">XS</option>
            <option value="s">S</option>
            <option value="m">M</option>
            <option value="l">L</option>
            <option value="xl">XL</option>
          </select>
          <p class="error-msg text-error text-xs mt-1 hidden" data-field="size"></p>
        </div>

        <div>
          <label for="height" class="block text-sm font-body font-medium text-espresso mb-1.5">Wzrost (cm)</label>
          <input
            type="number"
            id="height"
            name="height"
            required
            min="100"
            max="220"
            class="w-full px-4 py-3 rounded-xl border border-stone bg-ivory text-espresso font-body
                   focus:outline-none focus:ring-2 focus:ring-brass/40 focus:border-brass transition-colors"
            placeholder="165"
          />
          <p class="error-msg text-error text-xs mt-1 hidden" data-field="height"></p>
        </div>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full py-3.5 rounded-full bg-brass text-white font-body font-medium text-sm
               hover:bg-brass-dark cta-glow disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Chcę to sprawdzić
      </button>

      <p class="text-center text-xs text-warm-gray flex items-center justify-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        Żadnego spamu. Tylko konkrety.
      </p>
    </form>
  </div>
</section>
