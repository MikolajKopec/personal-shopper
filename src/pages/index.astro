---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import Bridge from '../components/Bridge.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SignupForm from '../components/SignupForm.astro';
import Footer from '../components/Footer.astro';
import QualifiedModal from '../components/QualifiedModal.astro';
import NotQualifiedModal from '../components/NotQualifiedModal.astro';
---

<Layout
  title="REFL. — Twoja prywatna stylistka"
  description="Prywatna stylistka dobierze dla Ciebie ubrania od projektantów, których w Polsce nie znajdziesz. Zapisz się na listę."
>
  <Nav />
  <main>
    <Hero />
    <div class="section-divider"></div>
    <PainPoints />
    <div class="section-divider"></div>
    <Bridge />
    <div class="section-divider"></div>
    <HowItWorks />
    <div class="section-divider"></div>
    <SignupForm />
  </main>
  <Footer />

  <QualifiedModal />
  <NotQualifiedModal />

  <script>
    import { actions } from 'astro:actions';

    // --- Nav scroll shadow ---
    const nav = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
      nav?.classList.toggle('nav-scrolled', window.scrollY > 20);
    }, { passive: true });

    // --- Scroll reveal ---
    const revealElements = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    revealElements.forEach((el) => revealObserver.observe(el));

    // --- Modal helpers ---
    function showModal(id: string) {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      requestAnimationFrame(() => modal.classList.add('active'));
      document.body.style.overflow = 'hidden';
    }

    function hideModal(id: string) {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.remove('active');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }, 300);
    }

    // Close modals on overlay click
    document.querySelectorAll('.modal-overlay').forEach((overlay) => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) hideModal(overlay.id);
      });
    });

    // Close modals on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay.active').forEach((m) => {
          hideModal((m as HTMLElement).id);
        });
      }
    });

    // Close buttons
    document.getElementById('modal-qualified-close')?.addEventListener('click', () => hideModal('modal-qualified'));
    document.getElementById('modal-not-qualified-close')?.addEventListener('click', () => hideModal('modal-not-qualified'));

    // --- Form submission ---
    let submittedEmail = '';

    const form = document.getElementById('signup-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear errors
      form.querySelectorAll('.error-msg').forEach((el) => el.classList.add('hidden'));

      submitBtn.disabled = true;
      submitBtn.textContent = 'Zapisuję...';

      const formData = new FormData(form);
      const { data, error } = await actions.signup(formData);

      if (error) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Chcę to sprawdzić';

        if (error.fields) {
          for (const [field, messages] of Object.entries(error.fields)) {
            const errorEl = form.querySelector(`.error-msg[data-field="${field}"]`) as HTMLElement;
            if (errorEl && messages?.length) {
              errorEl.textContent = messages[0];
              errorEl.classList.remove('hidden');
            }
          }
        }
        return;
      }

      submittedEmail = formData.get('email') as string;
      form.reset();
      submitBtn.disabled = false;
      submitBtn.textContent = 'Chcę to sprawdzić';

      if (data?.qualified) {
        showModal('modal-qualified');
      } else {
        showModal('modal-not-qualified');
      }
    });

    // --- Tag preorder interest when user clicks through to questionnaire ---
    document.getElementById('preorder-interest-btn')?.addEventListener('click', () => {
      if (submittedEmail) {
        fetch('/api/tag-preorder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: submittedEmail }),
        });
      }
    });
  </script>
</Layout>
